        "playerCapabilities": [
          "Open the carried contract result.",
          "Compare company officer histories.",
          "Retrieve a file by its File ID."
        ],
        "playerConstraints": [
          "Use only the provided public records.",
          "Corroborate control through the officer record.",
          "Keep contract, invoice, and inspection dates distinct."
        ],
        "environment": {
          "mode": "self-contained"
        },
        "narrativeContext": [
          "HP-2025-041 lists Northline as Calder’s subcontractor; the registry lists officers, addresses, and peer filings.",
          "Daniel Price controls Northline and is Calder’s Finance Director; his approved invoice conflicts with the 2025-09-14 inspection note.",
          "Retrieving the invoice confirms a paid claim and exposes the address; it offers an “Open parking record” control for the next step."
        ],
        "startingInputs": [
          {
            "id": "input_contract_result_bundle",
