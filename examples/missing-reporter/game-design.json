          }
        ],
        "terminalAction": {
          "actionType": "file-retrieval",
          "description": "Retrieve the disputed invoice in the File ID field. Format: INV-XX-NNNN.",
          "requiredOutputs": [
            {
              "id": "output_invoice_id",
              "semanticRole": "resource-identifier",
              "dataType": "string",
              "requiredValue": "INV-NS-7781"
